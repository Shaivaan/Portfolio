# Don't fill this by hand. Run:  npx neon@latest env pull
# It writes these variables (with real values) into .env.local for the linked Neon branch.

# Postgres: pooled for the app, unpooled (direct) for migrations
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=

# Object Storage (S3-compatible) for images and the resume PDF
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=

# Admin login. Don't fill by hand. Run:  npm run admin:set-password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
